  "PrivacyPolicyPage": {
    "title": "Gizlilik Politikası",
    "description": "Kişisel bilgilerinizi nasıl topladığımızı, kullandığımızı ve koruduğumuzu öğrenin.",
    "lastUpdated": "Son Güncelleme: 22 Nisan 2025",
    "section1Title": "Topladığımız Bilgiler",
    "section1Content": "Hesap oluşturduğunuzda, rezervasyon yaptığınızda veya müşteri hizmetlerimizle iletişime geçtiğinizde adınız, e-posta adresiniz, telefon numaranız ve ödeme bilgileriniz gibi doğrudan sağladığınız kişisel bilgileri toplarız.",
    "section2Title": "Bilgilerinizi Nasıl Kullanıyoruz",
    "section2Content": "Bilgilerinizi rezervasyonlarınızı işlemek, müşteri desteği sağlamak, (onay vermeniz halinde) promosyon teklifleri göndermek, hizmetlerimizi geliştirmek ve yasal yükümlülüklere uymak için kullanırız.",
    "section3Title": "Bilgi Paylaşımı",
    "section3Content": "Bilgilerinizi, rezervasyonunuzu tamamlamak için gerekli tur/seyahat sağlayıcılarıyla, bizim adımıza hizmet veren hizmet sağlayıcılarla ve kanunen gerektiğinde paylaşırız.",
    "section4Title": "Veri Güvenliği",
    "section4Content": "Kişisel bilgilerinizi yetkisiz erişim, değişiklik veya ifşaya karşı korumak için uygun güvenlik önlemleri uygularız.",
    "section5Title": "Haklarınız",
    "section5Content": "Konumunuza bağlı olarak kişisel bilgilerinize erişme, düzeltme veya silme haklarına sahip olabilirsiniz. Bu hakları kullanmak için bizimle iletişime geçin.",
    "section6Title": "Çerezler",
    "section6Content": "Web sitemizde deneyiminizi geliştirmek, kullanım alışkanlıklarını analiz etmek ve kişiselleştirilmiş içerik sunmak için çerezler ve benzeri teknolojiler kullanırız."
  },
  "TermsOfServicePage": {
    "title": "Hizmet Şartları",
    "description": "Lütfen hizmetlerimizi kullanmadan önce bu şartları dikkatle okuyun.",
    "lastUpdated": "Son Güncelleme: 22 Nisan 2025",
    "section1Title": "Şartların Kabulü",
    "section1Content": "Hizmetlerimize erişerek veya kullanarak bu Hizmet Şartları ve yürürlükteki tüm yasa ve yönetmeliklere tabi olmayı kabul edersiniz.",
    "section2Title": "Kullanıcı Hesapları",
    "section2Content": "Hesap bilgilerinizin gizliliğini korumaktan ve hesabınız altında gerçekleşen tüm faaliyetlerden siz sorumlusunuz.",
    "section3Title": "Rezervasyon ve Ödemeler",
    "section3Content": "Tüm rezervasyonlar uygunluk ve onaya tabidir. Fiyatlar, rezervasyonunuz onaylanana kadar bildirim yapılmaksızın değişebilir.",
    "section4Title": "İptaller ve İadeler",
    "section4Content": "İptal ve iade politikaları, rezervasyon türüne ve sağlayıcı şartlarına göre değişiklik gösterir. Rezervasyon yapmadan önce ilgili şartları inceleyiniz.",
    "section5Title": "Sorumluluk Sınırlaması",
    "section5Content": "Hizmetlerimizin kullanımından veya kullanılamamasından kaynaklanan doğrudan, dolaylı, arızi, özel veya sonuç olarak ortaya çıkan zararlardan sorumlu değiliz.",
    "section6Title": "Uygulanacak Hukuk",
    "section6Content": "Bu Şartlar, şirketimizin kayıtlı olduğu yargı alanının yasalarına tabi olacak ve onlara göre yorumlanacaktır."
  },
